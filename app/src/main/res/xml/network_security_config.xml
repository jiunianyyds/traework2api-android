<?xml version="1.0" encoding="utf-8"?>
<!--
  只禁止明文 HTTP：本 App 对上游（trae.cn / trae.ai）全走 HTTPS。
  刻意**不再放行 localhost / 127.0.0.1**：
  本 App 从不请求自己的本地服务（它只监听，不消费），而 127.0.0.1 只出现在
  「登录回调地址」这个字符串里（拼出来给浏览器看，App 自身不发请求）。
  留着那条 domain-config 只会扩大明文面而无任何收益。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
