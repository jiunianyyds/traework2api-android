<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 文本字号统一在 MainActivity 的 design token 里（FS_*），这里只保留主题，
         tw_ 与 tw_ 两套重复色已合并为 tw_ 一套。 -->
    <style name="Theme.TraeWork2API" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/tw_background</item>
        <item name="android:colorAccent">@color/tw_primary</item>
        <item name="android:colorControlHighlight">@color/tw_primary_container</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- 应用内弹窗统一进出（confirmDialog / 列表菜单 / 排序 / TimePicker）。
         刻意独立成一个只含窗口动画的样式：Theme.TraeWork2API 一个字都不动 ——
         换的是"怎么出现"，不是配色、圆角或主题。用法见 ui/Motion.applyDialogMotion()。 -->
    <style name="DialogMotion">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>
